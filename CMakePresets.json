{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name":"verbose-debug",
            "hidden":true,
            "cacheVariables": {
                "EXTENDED_DEBUG_OUTPUT_ENABLED": "ON"
            }
        },
        {
            "name": "gcc-g++",
            "displayName": "GCC 9.0 x86_64 G++",
            "description": "G++ 9 compiler for x86_64",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_CXX_FLAGS": "-march=native -Werror -Wall -Wextra -Wpedantic -Wunused -Wreorder -Wformat -Wimplicit-fallthrough -Wuninitialized -Winit-self" ,
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug",
            "description": "Debug for GCC G++ compiler",
            "inherits": [
                "gcc-g++",
                "verbose-debug"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Debug"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release",
            "description": "Release for GCC G++ compiler",
            "inherits": [
                "gcc-g++"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Release"
            }
        },
        {
            "name": "gcc-release-debug-symbols",
            "displayName": "GCC Release With Debug Symbols",
            "description": "Release for GCC G++ compiler (with debug symbols)",
            "inherits": [
                "gcc-g++"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-debug",
            "description": "G++ 9 compiler for x86_64",
            "displayName": "G++ 9 x86_64 (gcc)",
            "configurePreset": "gcc-debug",
            "configuration": "Debug"
        },
        {
            "name": "gcc-release",
            "description": "G++ 9 compiler for x86_64",
            "displayName": "G++ 9 x86_64 (gcc)",
            "configurePreset": "gcc-release",
            "configuration": "Release"
        }
    ],
    "testPresets": [

    ]
}