#ifndef CBLT_COLOR_ASSETS_H
#define CBLT_COLOR_ASSETS_H

#include <filesystem>
#include <string>

namespace cblt::color::asset {

static const std::string kAssetsBaseDir = "${CobaltColorAssetsDir}/";

static inline std::filesystem::path pathForResource(const std::string_view assetName) {
    return std::filesystem::path(kAssetsBaseDir) / std::filesystem::path(assetName);
}

}  // namespace cblt::color::asset

#endif  // CBLT_RENDER_TESTS_RESOURCES_H